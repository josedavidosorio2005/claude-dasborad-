node_modules/

# Variables de entorno con secretos — nunca al repo
.env
app.env
server/.env
*.env
!*.env.example
!server/.env.example

# Base de datos SQLite y copias de seguridad
server/data/

# Logs
*.log

# Datos de Caddy (certificados) si se ejecutan fuera de volumen
deploy/data/
deploy/config/

# Windows artifacts
%SystemDrive%/

# Migracion de cuenta AWS (inventario/notas de trabajo — nunca al repo,
# puede contener IDs de recursos y detalles internos de infraestructura)
migracion/

# Apps mobile/desktop (Fase 75): el proyecto Android/Capacitor generado en
# disco trae dependencias (node_modules, build/), rutas locales del SDK
# (local.properties) y el material de firma de las apps — nunca al repo.
# El .gitignore que cubria esto se borro sin querer en la Fase 70.
mobile-app/
desktop-app/
*.keystore
*.jks
*.p12
*.pfx
*-signing.properties
release-signing.properties

# Excel sueltos en docs/capturas-demo/ (Fase 76): 2 archivos locales de la
# Fase 67 (server/tests/fixtures/ es aparte, no lo toca esta regla)
# resultaron traer datos REALES de produccion de ORLANT (llenado-solo-
# trafico-local.xlsx: Llamadas 8.061/7.159/902 y WhatsApp 7.305/7.109/196,
# exacto igual a produccion) -- no se commitean ni se borran, se dejan en
# disco para quien los necesite. Cubre tambien cualquier otro .xlsx que se
# deje ahi por error al tomar capturas de demo en el futuro.
docs/capturas-demo/**/*.xlsx


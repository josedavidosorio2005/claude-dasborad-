{
  "//": "Config del CloudWatch Agent para la instancia de InConexion. Copiar a /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json y arrancar el agente. Envia los logs de los contenedores (app + Caddy) y del backup a CloudWatch Logs, y metricas basicas de la instancia.",
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/lib/docker/containers/*/*-json.log",
            "log_group_name": "/inconexion/prod/docker",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/inconexion-backup.log",
            "log_group_name": "/inconexion/prod/backup",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 90
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "InConexion/EC2",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] },
      "cpu": { "measurement": ["usage_active"], "totalcpu": true }
    }
  }
}

# ─────────────────────────────────────────────────────────────
# Variables para docker-compose (produccion).
# Copia este archivo a "app.env" y completa los valores reales:
#     cp app.env.example app.env
# NUNCA subas el "app.env" real a un repositorio.
#
# Nota: los valores van SIN comillas. El hash bcrypt lleva "$" y esta bien:
# docker-compose.yml usa "format: raw" para pasarlo literal.
# ─────────────────────────────────────────────────────────────

# Entorno. docker-compose ya fuerza "production"; dejalo asi.
NODE_ENV=production

# Puerto interno del backend dentro del contenedor.
PORT=3000

# ── Opcion A (recomendada en AWS): secretos en SSM Parameter Store ────
# Si defines SSM_PARAM_PREFIX, el servidor lee JWT_SECRET,
# MASTER_ADMIN_PASSWORD_HASH, MASTER_ADMIN_USER y CORS_ORIGIN desde
# AWS Systems Manager Parameter Store al arrancar (usando el rol IAM de la
# instancia) y puedes DEJAR VACIAS esas variables aqui abajo.
# Ver AWS_DEPLOY_REPORT.md para el comando de creacion de los parametros.
# SSM_PARAM_PREFIX=/inconexion/prod/
# AWS_REGION=us-east-1

# ── Opcion B: secretos en este archivo (genera los tuyos) ─────

# Clave para firmar los tokens de sesion (JWT). Minimo 32 caracteres.
# Genera una:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duracion de la sesion.
JWT_EXPIRES_IN=8h

# Usuario del administrador maestro (no vive en la tabla de usuarios).
MASTER_ADMIN_USER=admin

# Hash bcrypt de la contrasena del admin maestro (empieza con $2a$/$2b$).
# Genera el hash:  docker compose run --rm app node hash-password.js "tu-contrasena-segura"
# (o, sin Docker:  node server/hash-password.js "tu-contrasena-segura")
MASTER_ADMIN_PASSWORD_HASH=

# ── CORS ─────────────────────────────────────────────────────
# OBLIGATORIO en produccion. Tu dominio real, con https y sin barra final.
# Varios: separalos por coma.  Para probar en local: http://localhost:3000
CORS_ORIGIN=https://tudominio.com

# ── Reverse proxy ────────────────────────────────────────────
# Detras de Caddy/Nginx pon el numero de proxies (normalmente 1) para que el
# rate-limit y los logs vean la IP real del cliente. Sin proxy: false.
TRUST_PROXY=1

# ── Rate limiting (opcionales, tienen valores por defecto) ────
# Ventana y maximo global de la API:
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Ventana y maximo especifico del login (mas estricto):
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

# ── Base de datos / backups ──────────────────────────────────
# En docker-compose el DB_PATH lo fija el propio compose al volumen persistente.
# BACKUP_DIR: donde el script scripts/backup.js deja las copias.
BACKUP_DIR=/app/server/data/backups

# Subida de backups a S3 (Fase B5). Deja vacio para solo copia local.
# El bucket debe tener versionado activado. Credenciales via rol IAM de la instancia.
# BACKUP_S3_BUCKET=inconexion-backups-tuempresa
# BACKUP_S3_PREFIX=db-backups

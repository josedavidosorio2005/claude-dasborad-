# Copia este archivo a ".env" (mismo folder) y completa valores reales.
# NUNCA subas el archivo ".env" real a un repositorio publico.
#
# (Para despliegue con Docker usa el .env.example de la RAIZ del proyecto.)

# Entorno: development | test | production
NODE_ENV=development

# Puerto en el que corre el servidor
PORT=3000

# Clave secreta para firmar los tokens de sesion (JWT). MINIMO 32 caracteres.
# Genera una unica y aleatoria con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_por_una_clave_aleatoria_de_al_menos_32_caracteres

# Duracion de la sesion
JWT_EXPIRES_IN=8h

# Usuario del "administrador maestro" (superadmin que no vive en la tabla de usuarios)
MASTER_ADMIN_USER=admin

# Hash bcrypt de la contrasena del administrador maestro.
# Genera el hash con:  node hash-password.js "tu-contrasena-segura"
# y pega aqui SOLO el resultado (empieza con $2a$/$2b$, nunca la contrasena en texto plano).
MASTER_ADMIN_PASSWORD_HASH=

# Dominio(s) permitido(s) para peticiones al API (CORS), separados por coma.
# En desarrollo puedes dejarlo vacio (se permite localhost).
# En PRODUCCION es OBLIGATORIO y debe ser tu dominio real, ej:
#   CORS_ORIGIN=https://tuapp.com
CORS_ORIGIN=

# Numero de reverse proxies delante de la app (Caddy/Nginx). Sin proxy: false.
TRUST_PROXY=false

# Rate limiting (opcionales, con valores por defecto razonables)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=20

# Ruta del archivo de base de datos SQLite (opcional, tiene un valor por defecto)
# DB_PATH=./data/inconexion.db

# Carpeta donde scripts/backup.js deja las copias de seguridad (opcional)
# BACKUP_DIR=./data/backups
